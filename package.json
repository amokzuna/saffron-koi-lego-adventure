{
  "name": "lego-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:cross": "CROSS_BROWSER=1 playwright test --project=webkit --project=iphone-landscape --project=firefox",
    "check": "npm run typecheck && npm test && npm run build",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
